              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"fromAccountId\":\"{{aliceAccountId}}\",\"toAccountId\":\"{{bobAccountId}}\",\"amount\":999999}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
