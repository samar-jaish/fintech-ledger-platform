              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"fromAccountId\":\"{{aliceAccountId}}\",\"toAccountId\":\"{{bobAccountId}}\",\"amount\":100.25,\"description\":\"lunch\"}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlice}}",
                  "type": "string"
