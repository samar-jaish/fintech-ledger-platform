{
  "info": {
    "name": "Ledger Platform API",
    "description": "Start Postgres and Keycloak (docker compose up -d) and the app (mvn spring-boot:run), then run this collection with the Collection Runner. Requests run in order and depend on earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "tradingUrl",
      "value": "http://localhost:8082"
    }
  ],
  "item": [
    {
      "name": "0. Login (needs Keycloak running)",
      "item": [
        {
          "name": "Login as alice",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/ledger/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "ledger-api"
                },
                {
                  "key": "username",
                  "value": "alice"
                },
                {
                  "key": "password",
                  "value": "alice123"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token received', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenAlice', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as bob",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/ledger/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "ledger-api"
                },
                {
                  "key": "username",
                  "value": "bob"
                },
                {
                  "key": "password",
                  "value": "bob123"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token received', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('tokenBob', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin1",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/ledger/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "ledger-api"
                },
                {
                  "key": "username",
                  "value": "admin1"
                },
                {
                  "key": "password",
                  "value": "admin123"
