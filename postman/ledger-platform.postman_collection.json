    {
      "name": "1. Accounts and money",
      "item": [
        {
          "name": "Create account (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"ownerName\":\"Alice\",\"currency\":\"USD\"}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('aliceAccountId', pm.response.json().id);",
                  "pm.test('starts at zero', function () { pm.expect(pm.response.json().balance).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create account (bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"ownerName\":\"Bob\",\"currency\":\"USD\"}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenBob}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('bobAccountId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit 1000 (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{depKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/deposits"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":1000}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('depKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('not a replay', function () { pm.expect(pm.response.json().replayed).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit again, SAME key (replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{depKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/deposits"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":1000}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('is a replay', function () { pm.expect(pm.response.json().replayed).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Balance is 1000, not 2000 (alice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('balance 1000', function () { pm.expect(pm.response.json().balance).to.eql(1000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer 100.25 alice to bob",
          "request": {
            "method": "POST",
