          "expr": "ledger_outbox_pending",
          "legendFormat": "events waiting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ledger_outbox_oldest_pending_age_seconds",
          "legendFormat": "oldest waiting (seconds)",
          "refId": "B"
        }
      ]
